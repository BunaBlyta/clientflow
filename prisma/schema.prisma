generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STAFF
  CLIENT
}

enum ProjectRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PENDING
  DISCOVERY
  DESIGN
  DEVELOPMENT
  REVIEW
  LAUNCHED
  CANCELLED
  ON_HOLD
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAYMENT_PENDING
  PAID
  FAILED
  VOIDED
  REFUNDED
}

enum InvoiceType {
  DEPOSIT
  FINAL
  EXTRA
  CUSTOM
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  INVOICE_ISSUED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PROJECT_STAGE_CHANGED
  NEW_NOTE
  EXTRA_CHARGE_CREATED
}

enum PushDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                         String         @id @default(cuid())
  email                      String         @unique
  name                       String
  passwordHash               String?
  role                       UserRole       @default(CLIENT)
  isActive                   Boolean        @default(false)
  emailVerifiedAt            DateTime?
  verificationCodeHash       String?
  verificationCodeExpiresAt  DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  invitationTokenHash        String?
  invitationExpiresAt        DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  client                     Client?
  notes                      Note[]
  notifications              Notification[]
  pushDevices                PushDevice[]

  @@index([role])
}

model Client {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  email       String
  companyName String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       ProjectRequest[]
  projects       Project[]
  invoices       Invoice[]

  @@index([email])
}

model Package {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String
  price             Decimal         @db.Decimal(12, 2)
  currency          String          @default("usd")
  estimatedDuration String?
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  requests          ProjectRequest[]
  projects          Project[]
}

model ProjectRequest {
  id          String               @id @default(cuid())
  name        String
  email       String
  companyName String?
  message     String?
  status      ProjectRequestStatus @default(PENDING)
  packageId   String
  clientId    String?
  reviewedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  package     Package              @relation(fields: [packageId], references: [id], onDelete: Restrict)
  client      Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([status])
  @@index([email])
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  packageId   String?
  name        String
  description String?
  status      ProjectStatus @default(PENDING)
  startedAt   DateTime?
  launchedAt  DateTime?
  targetLaunchDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package     Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  notes       Note[]
  notifications Notification[]

  @@index([clientId])
  @@index([status])
}

model Invoice {
  id                       String        @id @default(cuid())
  projectId                String
  clientId                 String
  type                     InvoiceType
  description              String?
  amount                   Decimal       @db.Decimal(12, 2)
  currency                 String        @default("usd")
  status                   InvoiceStatus @default(DRAFT)
  dueDate                  DateTime?
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  paidAt                   DateTime?
  issuedAt                 DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  project                  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client                   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notifications            Notification[]

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  authorId  String?
  content   String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  projectId String?
  invoiceId String?
  requestId String?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice   Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  request   ProjectRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  pushDeliveries PushDelivery[]

  @@index([userId, readAt])
  @@index([createdAt])
  @@index([projectId])
  @@index([invoiceId])
  @@index([requestId])
}

model PushDevice {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  platform    String   @default("ios")
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  PushDelivery[]

  @@index([userId, isActive])
}

model PushDelivery {
  id               String             @id @default(cuid())
  notificationId   String
  deviceId         String
  status           PushDeliveryStatus @default(PENDING)
  attempts         Int                @default(0)
  expoTicketId     String?
  expoReceiptStatus String?
  lastError        String?
  nextAttemptAt    DateTime?
  sentAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device       PushDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
  @@index([status, nextAttemptAt])
  @@index([notificationId])
}
